# Runtime-only image: expects prebuilt Nitro output as `nitro-output/`.
# Used by GitHub Actions deploy (build on Actions, package on Liara).
# Debian slim: no apk against dl-cdn.alpinelinux.org (flaky TLS on Liara builders).
# Do not add BuildKit --mount flags — Liara's builder rejects them.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

# Prisma needs OpenSSL at runtime; bookworm-slim does not ship it by default.
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY nitro-output ./.output
COPY prisma ./prisma
COPY scripts/start-production.mjs ./scripts/start-production.mjs
COPY scripts/lib ./scripts/lib
COPY server ./server
COPY shared ./shared

# Nitro traces runtime deps into .output/server/package.json (e.g. nodemailer).
# Install them here — CI artifacts may omit node_modules to stay under upload limits.
# Strip Nitro's placeholder ".prisma" entry — npm rejects names that start with ".".
# --legacy-peer-deps: npm 10 arborist otherwise crashes (edgesOut) on peer skew
# when installing this lockfile-less Nitro package.json on Liara builders.
WORKDIR /app/.output/server
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));if(p.dependencies){for(const k of Object.keys(p.dependencies)){if(k.startsWith('.'))delete p.dependencies[k]}}fs.writeFileSync('package.json',JSON.stringify(p,null,2));" \
  && npm install --omit=dev --no-audit --no-fund --legacy-peer-deps
WORKDIR /app

RUN echo '{"name":"inbox-runtime","private":true}' > package.json \
  && npm install --omit=dev --no-save --ignore-scripts --no-audit --no-fund --prefer-offline \
    prisma@6.19.3 \
    @prisma/client@6.19.3 \
    tsx@4.22.4 \
  && npx prisma generate \
  && npm cache clean --force

COPY package.json ./package.json

EXPOSE 3000
CMD ["node", "scripts/start-production.mjs"]
